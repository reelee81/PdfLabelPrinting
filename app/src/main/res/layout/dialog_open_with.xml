<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="ifContentScrolls"
    tools:ignore="SpUsage, RtlHardcoded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_16">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/open_with_title"
            android:text="@string/open_with"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="@dimen/dp_18"
            android:textColor="@color/signature_chooser_title_text_color"
            android:layout_marginTop="@dimen/dp_24" />

        <FrameLayout
            android:id="@+id/open_with_pager_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20" />

        <LinearLayout
            android:id="@+id/open_with_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:gravity="center"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_with_btn_cancel"
            android:text="@string/cancel_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_24"
            android:textColor="@color/open_with_cancel_text_color"
            app:backgroundTint="@color/open_with_cancel_bg_color"
            app:cornerRadius="@dimen/dp_24" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
