<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dp_16"
    tools:ignore="SpUsage, RtlHardcoded">

    <FrameLayout
        android:id="@+id/progress_bar_indicator_update_ui_frame"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/progress_bar_update_ui_simple_text"
        app:layout_constraintHorizontal_chainStyle="packed">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar_indicator_update_ui"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:indeterminate="true"
            android:max="100"
            app:indicatorSize="@dimen/dp_48"
            app:indicatorInset="@dimen/dp_0"
            app:trackThickness="@dimen/dp_3" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/progress_bar_update_ui_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="@dimen/dp_11"
            android:textColor="@color/progress_info_text_color"
            android:visibility="invisible" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/progress_bar_update_ui_simple_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/dp_14"
        android:textColor="@color/progress_info_text_color"
        android:layout_marginLeft="@dimen/dp_14"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/progress_bar_indicator_update_ui_frame"
        app:layout_constraintRight_toRightOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
